# Set values in the hosting provider's secret/environment manager. Do not commit real credentials.
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://your-project.vercel.app
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=<unique-random-secret-at-least-32-characters>
JWT_EXPIRES_IN=7d
ACCOUNT_ENCRYPTION_KEY=<unique-random-64-character-hex-key>
RETURN_PASSWORD_RESET_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
SMTP_FROM=RVPay <no-reply@example.com>
